    },
    {
      "id": "comment-main",
      "file": "utils/download/Downloader.ts:339",
      "finding": "Actual downloader paginates elected comments using buffer/continue_flag; it uses more request parameters than the previously inspected simplified misc API."
    },
    {
      "id": "reply-coverage",
      "file": "utils/download/Downloader.ts:410",
      "finding": "One getcommentreply fetch per comment needing replies, limit 100; no per-comment repeated paging or original+fetched stable-ID merge/count verification found in this path. Actual loss not established."
    },
    {
      "id": "credential-route",
      "file": "utils/download/BaseDownloader.ts:34",
      "finding": "Public proxies default if no private proxy; comment target URL, headers including Cookie, and proxy authorization are carried via encoded query parameters. Not selected for liumo."
    },
    {
      "id": "credential-duration",
      "file": "config/index.ts",
      "finding": "25 minutes is a client validity constant; helper watcher filters 30 minutes. Neither proves server credential lifetime or autonomous renewal."
    },
    {
      "id": "helper-storage",
      "file": "resources/credential.py:43",
      "finding": "Captures article URL and Set-Cookie to resources/data/credentials.json; prints parsed URLs. Local watcher sends recent data over WSS to connected clients. Not executed."
    },
    {
      "id": "markdown-images",
      "file": "utils/download/Exporter.ts:62",
      "finding": "Markdown path does not call extractResources/processExportQueue; HTML/PDF paths do. Local images are not established for Markdown."
    },
    {
      "id": "pdf-originality",
      "file": "server/api/web/pdf/generate.post.ts",
      "finding": "setContent plus page.pdf on processed HTML; not original WeChat page full PNG. Comment renderer builds its own HTML."
    },
    {
      "id": "script-parsing",
      "file": "shared/utils/html.ts:150",
      "finding": "Client iframe / server QuickJS executes extracted cgi script. Reviewed only; not executed or adopted."
    }
